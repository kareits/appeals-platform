# Example environment configuration for local development.
# Copy to `.env` and adjust. Never commit real secrets (see root CLAUDE.md).
# The compose file also has inline defaults, so `docker compose up` works without this file.

# --- Platform-wide ---
# Business timezone for date and working-hours computation (retention dates, SLA calendars).
# Timestamps are always STORED in UTC (ADR-003); this only affects business-date/working-hours math.
# Kazakhstan (Astana/Almaty) is UTC+5 with no daylight saving. Shared across services.
PLATFORM_TIMEZONE=Asia/Almaty

# --- Reverse proxy ---
# Host port that exposes the demo service through Caddy.
HTTP_PORT=8080

# --- PostgreSQL (shared cluster) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Per-service database passwords (dev placeholders). The provisioning job reconciles an existing
# role's password on every startup (safe SQL quoting), so rotating a value here and re-running
# `docker compose up` updates the role. Passwords may contain URI-reserved characters (':', '@',
# '/', '?', '#'): the IAM/Ticket/BFF services build their connection URL from discrete parts with a
# percent-encoded password, so such secrets no longer corrupt the URL (CR-BFF-R3-MEDIUM-003).
DEMO_DB_PASSWORD=demo
FLOWABLE_DB_PASSWORD=flowable
IAM_DB_PASSWORD=iam
TICKET_DB_PASSWORD=ticket
BFF_DB_PASSWORD=bff

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# --- Demo service ---
# In compose the service connects to PostgreSQL; for local (non-Docker) runs and unit tests an
# embedded SQLite backend is used instead.
DEMO_ENVIRONMENT=local
DEMO_DATABASE_URL=sqlite+aiosqlite:///./demo_service.db

# --- IAM service ---
# Dev/local authentication is available OUTSIDE production only (docs/06). In production the dev
# login is disabled and the platform moves to corporate OIDC (ADR-AUTH-OIDC, TASK_06).
IAM_ENVIRONMENT=local
IAM_DATABASE_URL=sqlite+aiosqlite:///./iam_service.db
# Symmetric signing secret for dev-issued access tokens. Dev placeholder only; never a real secret.
IAM_JWT_SECRET=dev-insecure-secret-change-me-please

# --- Ticket service ---
# In compose the service connects to PostgreSQL; for local (non-Docker) runs and unit tests an
# embedded SQLite backend is used instead.
TICKET_ENVIRONMENT=local
TICKET_DATABASE_URL=sqlite+aiosqlite:///./ticket_service.db
# Secret used to verify IAM-issued access tokens. MUST match IAM_JWT_SECRET. Dev placeholder only.
TICKET_JWT_SECRET=dev-insecure-secret-change-me-please

# --- BFF service ---
# The single API gateway for the frontend. It owns an (empty) database only to reserve its schema
# (ADR-004) and reaches IAM and Ticket over HTTP. In compose these point at the internal services.
BFF_ENVIRONMENT=local
BFF_DATABASE_URL=sqlite+aiosqlite:///./bff_service.db
BFF_IAM_BASE_URL=http://localhost:8000
BFF_TICKET_BASE_URL=http://localhost:8000
