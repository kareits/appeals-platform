# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments and tooling caches
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# uv
uv.lock.local

# Local databases and env files
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Local code-review reports (kept out of version control). They document open security findings with
# reproduction steps and quote the local stack's development credentials, so they are transferred
# between working machines out of band rather than published with the repository.
reviews/

# Local document-service file storage (the default DOCUMENT_STORAGE_ROOT for non-Docker runs).
# Stored objects are data, never source; in compose they live on the document-data volume.
document-storage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
