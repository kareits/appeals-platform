{
  // Dependency-audit gate for the web frontend. Fails the build on high and critical advisories,
  // replacing the bare `npm audit --audit-level=high` so specific, non-applicable advisories can be
  // allowlisted with an audit trail instead of weakening the whole threshold.
  "high": true,

  // No advisories are currently allowlisted: react-router-dom 7.18.2 leaves the vulnerable range of
  // GHSA-qwww-vcr4-c8h2 (RSC CSRF), so its temporary allowlist entry was removed per its TODO. Add a
  // new entry here (with a dated reason and removal condition) only for a non-applicable advisory
  // that has no clean upgrade target.
  "allowlist": [],
}
